{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://s60-inventory.onrender.com/api/$1" },
    { "source": "/uploads/(.*)", "destination": "https://s60-inventory.onrender.com/uploads/$1" },
    { "source": "/portal/(.*)", "destination": "/$1" },
    { "source": "/portal", "destination": "/index.html" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/((?!assets/|vendor/|.*\\..*).*)$", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,DELETE,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ]
}
