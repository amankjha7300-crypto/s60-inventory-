{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/portal", "destination": "/index.html" },
    { "source": "/portal/", "destination": "/index.html" },
    { "source": "/portal/:match*", "destination": "/:match*" },
    { "source": "/api/:match*", "destination": "https://s60-inventory.onrender.com/api/:match*" },
    { "source": "/uploads/:match*", "destination": "https://s60-inventory.onrender.com/uploads/:match*" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,DELETE,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ]
}
