# S60 Inventory & Rewards Management System
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Database Configuration
# For local development, sqlite fallback is supported out of the box if postgres is not provided:
# DATABASE_URL=postgresql://s60admin:password123@localhost:5432/s60inventory
DATABASE_URL=sqlite:///./s60inventory.db

# Authentication Security
JWT_SECRET=super60_sviet_management_secret_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Dev SuperAdmin (seeded on first startup)
DEFAULT_ADMIN_EMAIL=admin@s60sviet.in
DEFAULT_ADMIN_PASSWORD=S60Admin@2026
DEFAULT_ADMIN_NAME="S60 Management"

# CORS Allowed Origins
CORS_ORIGINS=*
